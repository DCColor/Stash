{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stash",
  "version": "0.5.6",
  "identifier": "com.graviton.stash",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stash",
        "width": 800,
        "height": 600,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src https://graviton.tools"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Amigo Media LLC (8UQ7MDM87B)",
      "hardenedRuntime": true,
      "entitlements": "./entitlements.plist"
    }
  }
}
